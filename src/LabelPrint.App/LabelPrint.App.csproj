<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>LabelPrint</RootNamespace>
    <AssemblyName>LabelPrint</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- IC_D600.dll and acsr2032.dll are 32-bit, matching the VB6 exe. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>jumping-gym-labelprint-1e7c9a4b</UserSecretsId>
    <Version>1.6.0</Version>
    <InformationalVersion>1.6.0-net8</InformationalVersion>
    <Product>LabelPrint</Product>
    <Company>Jumping Gym U.S.A</Company>
    <AssemblyTitle>LabelPrint</AssemblyTitle>
    <Description>LabelPrint 1.6 (CardPrint4) rebuilt as a .NET 8 Windows Forms application.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LabelPrint.Core\LabelPrint.Core.csproj" />
    <ProjectReference Include="..\LabelPrint.Data\LabelPrint.Data.csproj" />
    <ProjectReference Include="..\LabelPrint.Printing\LabelPrint.Printing.csproj" />
    <ProjectReference Include="..\LabelPrint.CardReader\LabelPrint.CardReader.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\templates\*.lbl" Link="templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\CardReader.config" Link="CardReader.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
